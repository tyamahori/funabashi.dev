---
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = SITE_DESCRIPTION } = Astro.props;
const pageTitle = title ? `${title} | ${SITE_TITLE}` : SITE_TITLE;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">Funabashi<span class="brand-dot">.dev</span></a>
      <nav>
        <a href="/about">About</a>
        <a href="/activities">活動</a>
        <a href="/events">イベント</a>
        <a href="/news">新聞部</a>
        <a class="nav-join" href="/join">参加する</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p>Funabashi.dev — 船橋を中心としたIT/Web系開発者コミュニティ(2021年〜)</p>
      <p class="footer-note">マスコット: ふなデブくん 🍐(枝がFの梨、5年越しの採用)</p>
    </footer>
  </body>
</html>

<style is:global>
  /* パレットは「ふなでぶにゅーす」紙面と同系(紙・墨・金・葉)。新聞部との連続性を持たせる */
  :root {
    --paper: #f5f4ec;
    --surface: #fdfcf7;
    --ink: #22261b;
    --muted: #6d7260;
    --gold: #a8821f;
    --gold-bg: rgba(168, 130, 31, 0.08);
    --leaf: #55742f;
    --leaf-ink: #3f5723;
    --stamp: #ba3d2c;
    --hairline: rgba(34, 38, 27, 0.22);
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --paper: #16180f;
      --surface: #1e2115;
      --ink: #e6e3d2;
      --muted: #9ba089;
      --gold: #d0ab4c;
      --gold-bg: rgba(208, 171, 76, 0.1);
      --leaf: #93b063;
      --leaf-ink: #a8c47a;
      --stamp: #de6a55;
      --hairline: rgba(230, 227, 210, 0.22);
    }
  }

  * {
    box-sizing: border-box;
  }
  html {
    scroll-behavior: smooth;
  }
  body {
    margin: 0;
    color: var(--ink);
    background: var(--paper);
    font-family: 'Hiragino Kaku Gothic ProN', 'Yu Gothic', Meiryo, sans-serif;
    line-height: 1.85;
  }
  h1 {
    font-size: 1.7rem;
    line-height: 1.5;
    margin: 0 0 1rem;
  }
  h2 {
    font-size: 1.25rem;
    margin: 2.5rem 0 0.75rem;
    padding-left: 0.6rem;
    border-left: 4px solid var(--leaf);
  }
  a {
    color: var(--leaf-ink);
  }

  .site-header {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    align-items: center;
    padding: 0.9rem 1.5rem;
    border-bottom: 2px solid var(--ink);
    background: var(--surface);
  }
  .site-header .brand {
    font-weight: 700;
    font-size: 1.1rem;
    text-decoration: none;
    color: var(--ink);
    margin-right: auto;
  }
  .brand-dot {
    color: var(--leaf);
  }
  .site-header nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    font-size: 0.95rem;
  }
  .site-header nav a {
    color: var(--ink);
    text-decoration: none;
    padding: 0.15rem 0.2rem;
  }
  .site-header nav a:hover {
    color: var(--leaf-ink);
  }
  .nav-join {
    font-weight: 700;
    color: var(--leaf-ink) !important;
  }

  main {
    max-width: 46rem;
    margin: 0 auto;
    padding: 2.25rem 1.25rem 4rem;
  }

  .site-footer {
    border-top: 1px solid var(--hairline);
    padding: 1.5rem;
    color: var(--muted);
    font-size: 0.85rem;
    text-align: center;
  }
  .site-footer p {
    margin: 0.2rem 0;
  }

  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 1.5rem 0;
  }
  .cta {
    display: inline-block;
    padding: 0.65rem 1.5rem;
    border-radius: 999px;
    text-decoration: none;
    font-weight: 700;
  }
  .cta.primary {
    background: var(--leaf);
    color: #fff;
  }
  .cta.secondary {
    border: 2px solid var(--leaf);
    color: var(--leaf-ink);
  }
  .cta.primary:hover,
  .cta.secondary:hover {
    opacity: 0.85;
  }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 0.9rem;
    margin: 1.25rem 0;
    padding: 0;
    list-style: none;
  }
  .card {
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: 10px;
    padding: 1rem 1.15rem;
  }
  .card h3 {
    margin: 0 0 0.4rem;
    font-size: 1.02rem;
  }
  .card p {
    margin: 0;
    font-size: 0.92rem;
    color: var(--muted);
  }

  .notice {
    background: var(--gold-bg);
    border-left: 4px solid var(--gold);
    padding: 0.8rem 1.1rem;
    border-radius: 0 8px 8px 0;
  }
</style>
