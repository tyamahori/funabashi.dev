---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { NEWS_CATEGORIES } from '../../consts';

export async function getStaticPaths() {
  const entries = await getCollection('news');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const fmt = new Intl.DateTimeFormat('ja-JP', { dateStyle: 'medium' });

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: entry.data.title,
  datePublished: entry.data.date.toISOString(),
  inLanguage: 'ja',
  url: new URL(`/news/${entry.id}/`, Astro.site).href,
  image: new URL('/ogp.jpg', Astro.site).href,
  author: {
    '@type': 'Organization',
    name: 'Funabashi.dev ふなデブくん新聞部',
    url: Astro.site?.href,
  },
  ...(entry.data.description ? { description: entry.data.description } : {}),
};
---

<Base title={entry.data.title} description={entry.data.description} ogType="article">
  <Fragment slot="head">
    <meta property="article:published_time" content={entry.data.date.toISOString()} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  </Fragment>
  <article>
    <h1>{entry.data.title}</h1>
    <p>
      <small>
        {NEWS_CATEGORIES[entry.data.category]} / {fmt.format(entry.data.date)}
      </small>
    </p>
    <Content />
    <aside class="hitokoto">
      <p>ふなデブくんの一言 🍐 — {entry.data.hitokoto}</p>
    </aside>
  </article>
</Base>

<style>
  .hitokoto {
    margin-top: 2rem;
    padding: 1rem 1.25rem;
    border: 1px solid var(--hairline);
    border-left: 3px solid var(--accent);
    border-radius: 8px;
    background: var(--surface);
  }
</style>
