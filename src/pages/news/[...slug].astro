---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { NEWS_CATEGORIES } from '../../consts';

export async function getStaticPaths() {
  const entries = await getCollection('news');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const fmt = new Intl.DateTimeFormat('ja-JP', { dateStyle: 'medium' });
---

<Base title={entry.data.title} description={entry.data.description}>
  <article>
    <h1>{entry.data.title}</h1>
    <p>
      <small>
        {NEWS_CATEGORIES[entry.data.category]} / {fmt.format(entry.data.date)}
      </small>
    </p>
    <Content />
    <aside class="hitokoto">
      <p>ふなデブくんの一言 🍐 — {entry.data.hitokoto}</p>
    </aside>
  </article>
</Base>

<style>
  .hitokoto {
    margin-top: 2rem;
    padding: 1rem 1.25rem;
    border-left: 4px solid var(--accent);
    background: rgba(85, 116, 47, 0.06);
  }
</style>
