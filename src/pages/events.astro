---
import Base from '../layouts/Base.astro';
import { CONNPASS_URL } from '../consts';
import { getEvents, formatDateLabel, formatDateShort } from '../lib/connpass';

// ビルド時にconnpassから取得(失敗時は events-fallback.json)。鮮度は日次再ビルドで担保する
const { upcoming, past, live } = await getEvents();
const nextEvent = upcoming[0];
---

<Base
  title="イベント"
  description="Funabashi.devのイベント情報。船橋市内を主会場にした勉強会・懇親会の次回開催案内と、これまでの開催実績一覧。参加申込はconnpassで受け付けています。"
>
  <h1>イベント</h1>
  <p>
    船橋市内を主会場に、年数回の勉強会と季節の懇親会を開いています。
    募集はすべて <a href={CONNPASS_URL}>connpass</a> です。
  </p>

  <h2>次回</h2>
  {
    nextEvent ? (
      <div class="notice">
        <p style="margin: 0;">
          <strong>{nextEvent.title}</strong>
          <br />
          {formatDateLabel(nextEvent.start)} — 申込は <a href={nextEvent.url}>connpass</a> から
        </p>
      </div>
    ) : (
      <p class="notice">
        次回は準備中です。募集開始は <a href={CONNPASS_URL}>connpass</a> でお知らせします。
      </p>
    )
  }

  <h2>開催実績({past.length}回)</h2>
  <ul>
    {
      past.map((e) => (
        <li>
          <small>{formatDateShort(e.start)}</small> {e.title}
        </li>
      ))
    }
  </ul>
  <p>
    各回の内容は<a href={`${CONNPASS_URL}/event/`}>connpass のイベント一覧</a>からどうぞ。
  </p>

  <p>
    勉強会はLT中心で、初登壇の練習の場としてもどうぞ。
    聞くだけの参加も歓迎です。
  </p>
  <span hidden data-events-source={live ? 'connpass-live' : 'fallback'}></span>
</Base>
